# ================================================================
# BROKERGY — Backend Environment Variables
# Copiar este fichero como .env y rellenar todos los valores
# ================================================================

# ----- Servidor -----
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://app.brokergy.es

# ----- Supabase -----
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----- Google Drive OAuth2 -----
# Generar con: node scripts/drive_auth.js  (solo una vez o si caduca el token)
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxx
GOOGLE_OAUTH_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- Carpetas Google Drive -----
# DRIVE_ROOT_FOLDER_ID  = carpeta raíz ("01. OPORTUNIDADES")
# DRIVE_TEMPLATE_ID     = carpeta plantilla que se clona al crear oportunidad
#
# El resto son las carpetas de ESTADO. TODAS son opcionales: services/driveFolders.js
# lleva los IDs reales como valor por defecto, así que no hace falta definirlas.
# Solo hay que ponerlas aquí si alguna carpeta se recrea en Drive con otro ID.
# El mapa estado→carpeta vive en services/driveFolders.js (única fuente).
DRIVE_ROOT_FOLDER_ID=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DRIVE_TEMPLATE_ID=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DRIVE_FOLDER_ENVIADA=1C4XSprT61mOgpW6LSNXwXefwuFRqudjn              # 02. SIMULACION ENVIADA
DRIVE_FOLDER_ACEPTADA=1L2Wl9OIOpvmihySZkT09S1FG14Pu3VNy             # 03. ACEPTADO
DRIVE_FOLDER_EN_CURSO=1sXDU-s-MqZ6EJSZnoMtAXJHcm_AIjL78             # 04. EN CURSO
# DRIVE_FOLDER_DOC_COMPLETA=                                        # 05. DOC. COMPLETA
# DRIVE_FOLDER_LISTO_VERIFICAR=                                     # 06. REVISADO LISTO PARA VERIFICAR
# Carpeta "07. ENVIADOS A VERIFICAR": padre de las carpetas de cada lote ya enviado
# (dentro viven los expedientes del lote + sus documentos).
DRIVE_FOLDER_ENVIADOS_VERIFICAR=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DRIVE_FOLDER_PAGO_BROKERGY=                                       # 08. PENDIENTE DE PAGO A BROKERGY
# DRIVE_FOLDER_PAGO_CLIENTE=                                        # 09. PENDIENTE DE PAGO A CLIENTE
# DRIVE_FOLDER_REQUERIMIENTO=                                       # 10. REQUERIMIENTO
# DRIVE_FOLDER_FINALIZADOS=                                         # 11. FINALIZADOS
# DRIVE_FOLDER_RECHAZADOS=                                          # 12. RECHAZADOS
# DRIVE_FOLDER_DOC_COMPLETA_APPSHEET=                               # 13. DOC. COMPLETA APPSHEET

# ----- Google Maps (geocoding backend) -----
# Restringir en Google Cloud Console a la IP del servidor Railway
GOOGLE_MAPS_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- Generador RITE (microservicio Python) -----
# Servicio que genera la Memoria Técnica RITE (.docx) + Guía JE6 (.pdf).
# En producción (Docker Compose) lo inyecta docker-compose.yml como
# RITE_SERVICE_URL=http://rite-generator:8080 (red interna). En local, si no se
# define, el backend usa el valor por defecto http://localhost:8090
# (arrancar el servicio con: cd implementation/rite-generator && uvicorn server:app --port 8090).
RITE_SERVICE_URL=http://localhost:8090

# ----- Catastro (APIs públicas — los valores por defecto son correctos) -----
CATASTRO_API_URL=http://ovc.catastro.meh.es/ovcservweb/OVCSWLocalizacionRC/OVCCallejero.asmx
CATASTRO_COORD_API_URL=http://ovc.catastro.meh.es/ovcservweb/OVCSWLocalizacionRC/OVCCoordenadas.asmx

# ----- SMTP -----
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=465
SMTP_USER=usuario@tudominio.es
SMTP_PASS=REEMPLAZAR
SMTP_FROM="Tu Empresa" <usuario@tudominio.es>

# ----- Remitente del correo al Sujeto Obligado (lotes) — OPCIONAL -----
# El correo al S.O. puede salir desde otra dirección del mismo dominio. Si el
# proveedor SMTP no permite "enviar-como", hay que dar las credenciales propias de
# ese buzón aquí. Sin ellas, el correo del S.O. cae a la cuenta SMTP principal.
LOTE_SO_EMAIL_FROM=remitente-alternativo@tudominio.es
LOTE_SO_SMTP_USER=remitente-alternativo@tudominio.es
LOTE_SO_SMTP_PASS=REEMPLAZAR
# LOTE_SO_SMTP_HOST=smtp.tu-proveedor.com   # opcional (por defecto = SMTP_HOST)
# LOTE_SO_SMTP_PORT=465                      # opcional (por defecto = SMTP_PORT)

# ----- WhatsApp (whatsapp-web.js) — OPCIONAL -----
# WHATSAPP_ENABLED=true solo funciona en servidor persistente (VPS con Docker)
# La sesión vive en el volumen brokergy_whatsapp_auth y sobrevive a los deploys:
# el servicio se reconecta SOLO al arrancar. Solo hay que escanear el QR si
# WhatsApp invalida la sesión (dispositivo desvinculado, móvil >14 días offline).
WHATSAPP_ENABLED=false
WHATSAPP_CLIENT_ID=brokergy-main
WWA_MIN_DELAY_MS=2500
WWA_MAX_DELAY_MS=6000
WWA_TYPING_MS=1500
WWA_RATE_PER_MIN=10
WWA_MAX_RETRIES=5

# --- Supervisor de auto-conexión (watchdog) ---
# Reintenta la conexión sin intervención humana y avisa por email si es
# imposible. Ponlo a false en desarrollo local para que no relance Chrome.
WHATSAPP_AUTO_RECONNECT=true
WWA_WATCHDOG_MS=20000            # cada cuánto revisa el estado
WWA_INIT_TIMEOUT_MS=180000       # margen de arranque de Chrome antes de darlo por fallido
WWA_STUCK_MS=240000              # INITIALIZING/AUTHENTICATED más de esto = colgado → reset
WWA_ALERT_AFTER_FAILURES=6       # fallos seguidos antes de mandar el email de aviso

# Destinatario de las notificaciones admin (aceptaciones, cambios de estado)
# Puede ser un número de teléfono (ej: 34623926179) o el chatId de un grupo (ej: 120363XXXX@g.us)
# Para obtener el ID de un grupo: en el panel admin → WhatsApp → "Ver Grupos"
WHATSAPP_ADMIN_CHAT=34623926179

# Email del admin para alertas técnicas (rate-limit de Catastro, etc.).
# Si no se define, fallback a info@brokergy.es.
ADMIN_EMAIL=info@brokergy.es

# Ventana de agrupación de los avisos de "documentación recibida" (uploadNotifier).
# El enlace público sube FOTO A FOTO: se espera este silencio antes de mandar UN
# solo resumen de la tanda al grupo. Por defecto 30 min.
UPLOAD_NOTIFY_WINDOW_MS=1800000

# ----- Cloudflare Turnstile (anti-bot landing pública) — OPCIONAL en dev -----
# Mientras TURNSTILE_ENABLED=false la landing pública omite la verificación
# (útil para arrancar sin keys). En producción debe ser true.
# Generar keys en: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=0xXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# En frontend (Vite) hace falta también:
#   VITE_TURNSTILE_SITE_KEY=0xXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ----- OCR de CEE en "Nueva simulación" (solo ADMIN) -----
# Adaptador conmutable: gemini (por defecto) | openai
CEE_OCR_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Si CEE_OCR_PROVIDER=openai:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# ─── Avisos automáticos al admin ─────────────────────────────────────────────
# Tope duro entre avisos repetidos (por defecto 6 h). Un canal de alertas que
# puede repetirse agota la cuota del buzón (Hostinger: 100 correos/24 h) y deja
# a toda la app sin poder enviar. Incidente del 24/07/2026.
# En LOCAL conviene ponerlos a false: el portátil no tiene sesión de WhatsApp y
# comparte buzón con producción.
WWA_ALERT_EMAIL=true
WWA_ALERT_COOLDOWN_MS=21600000
CATASTRO_ALERT_EMAIL=true
CATASTRO_ALERT_COOLDOWN_MS=21600000
# Buzón por el que salen los avisos INTERNOS (WhatsApp caído, Catastro bloqueado).
# Por defecto usa el buzón secundario si existe, para no gastar la cuota del que
# escribe a clientes. Vacío = remitente normal.
ALERT_EMAIL_FROM=

# --- CEE directos ---
# Carpeta de Drive "26. CERTIF. EFICIENCIA ENER / 1. PRODUCCION".
DRIVE_CEE_PRODUCCION_FOLDER_ID=
# Entrega automatica del certificado al cliente (email + WhatsApp) en cuanto
# coinciden: cobrado + justificante de registro subido + PDF firmado subido.
# En PRODUCCION va a true. EN LOCAL PONLO A false: si no, cualquier prueba
# manda el certificado de verdad al cliente de verdad.
CEE_ENTREGA_AUTO=true

# --- Bot de WhatsApp (responde a los chats etiquetados) ---
# APAGADO POR DEFECTO. Ponerlo a true hace que el bot conteste a CLIENTES
# REALES por la sesión de WhatsApp del VPS. En LOCAL déjalo en false salvo que
# estés probando a propósito contra un chat tuyo.
BOT_WHATSAPP_ENABLED=false
# Etiqueta de WhatsApp Business que marca los chats que atiende el bot.
# Las etiquetas SOLO existen en WhatsApp Business.
BOT_WHATSAPP_ETIQUETA=MOIA
# Lista blanca para la fase de pruebas: chatIds separados por coma
# ('34612345678@c.us'). Se comprueba ADEMÁS de la etiqueta, así que con esto
# puesto el bot solo habla con esos chats aunque haya más etiquetados.
# SIN ESTO EL BOT NO ARRANCA (salvo BOT_WHATSAPP_TODOS=true): salir del modo
# prueba tiene que ser una decisión escrita, no un descuido.
BOT_WHATSAPP_CHATS_PRUEBA=
# Atender a TODOS los chats etiquetados. Se pone a mano cuando el bot ya se haya
# ganado la confianza en pruebas.
BOT_WHATSAPP_TODOS=false
# Horario laboral, hora de pared en Madrid (se respeta el cambio de hora).
# Fuera de él NO contesta, pero tampoco pierde el mensaje: lo responde en la
# próxima apertura.
BOT_WHATSAPP_HORA_DESDE=8
BOT_WHATSAPP_HORA_HASTA=20
# Ventana de silencio antes de contestar. El cliente manda tres mensajes
# seguidos ("Buenas tardes" / la pregunta / "Gracias") y se responde UNA vez a
# todo junto: contestar al primero es contestar a un saludo.
BOT_WHATSAPP_VENTANA_MS=25000
# Si alguien del equipo ha escrito en ese chat hace menos de esto, el bot calla.
BOT_WHATSAPP_SILENCIO_HUMANO_MIN=30
# Tope de mensajes al día. Freno contra el bloqueo de la cuenta: no es una API
# oficial y un volumen alto de respuestas automáticas es lo que se detecta.
BOT_WHATSAPP_MAX_DIA=40
# Turnos anteriores del chat que se le recuerdan al asistente.
BOT_WHATSAPP_HISTORIAL=4
# Cada cuánto se despacha lo pendiente.
BOT_WHATSAPP_BARRIDO_MS=30000
# Plazo de CADA llamada a WhatsApp (Puppeteer) y tope de un barrido entero.
# Ninguna llamada va sin plazo: un Chrome atascado dejaría el bot mudo y sin
# avisar, porque el cerrojo del barrido no se soltaría nunca.
BOT_WHATSAPP_PLAZO_WA_MS=15000
BOT_WHATSAPP_BARRIDO_MAX_MS=300000
# Modelo. Por defecto el mismo que el OCR (GEMINI_MODEL). Necesita GEMINI_API_KEY.
BOT_WHATSAPP_MODEL=
BOT_WHATSAPP_TIMEOUT_MS=45000
# Vigencia de las pistas que dicen de qué obra habla un chat (horas).
# La de conversación es corta a propósito: "la de Tomelloso" contesta a la
# pregunta de HOY; con una semana de vigencia el bot respondería por la obra
# equivocada el lunes siguiente.
BOT_VINCULO_CONVERSACION_H=8
BOT_VINCULO_ENVIO_H=72
# Espera cuando el modelo dice que se agotó la cuota (429). No escala ni avisa:
# reprograma, porque la cuota es transitoria.
BOT_WHATSAPP_REINTENTO_CUOTA_MS=120000
# Recuperar lo que llegó con el backend parado (en cada deploy hay un hueco).
# Al arrancar repasa los chats etiquetados y recoge lo que quedó sin contestar.
# Solo mensajes recientes, solo si nadie respondió después, y con tope de chats.
BOT_RECUPERAR=true
BOT_RECUPERAR_HORAS=6
BOT_RECUPERAR_MAX_CHATS=25
# Purga de la bandeja del bot. Lo PENDIENTE nunca se borra, aunque sea viejo:
# si algo lleva ahí atascado meses, borrarlo es esconder el problema.
BOT_PURGA_DIAS=120
