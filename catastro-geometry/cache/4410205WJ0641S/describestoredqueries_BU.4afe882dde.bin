  <StoredQueryDescription id="GetBuildingByParcel">
    <Abstract>Edificios por referencia catastral, los parámetros requeridos son REFCAT y SRSNAME</Abstract>
    <Abstract>Buildings by common cadastral parcel identification, parameters REFCAT and SRSNAME are mutually exclusive</Abstract>
    <Abstract xml:lang="en">Any parameter KEY of type fes:Literal is substituable by common KVP standard KEY=VALUE</Abstract>
    <Parameter name="REFCAT" type="fes:Literal">
      <Abstract>Referencia catastral</Abstract>
      <Abstract>Common cadastral parcel identification</Abstract>
    </Parameter>    
    <Parameter name="SRSNAME" type="fes:Literal">
      <Abstract>Huso de la petición</Abstract>
      <Abstract>Cadastre projection</Abstract>
    </Parameter>
    <QueryExpressionText returnFeatureTypes="bu:Building" language="urn:ogc:def:queryLanguage:OGC-WFS::WFS_QueryExpression" isPrivate="true" />
  </StoredQueryDescription>
